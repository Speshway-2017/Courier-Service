PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_change_in_production
NODE_ENV=development

# Admin Credentials (Single Authorized User)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin Manager
ADMIN_EMAIL=admin@fasttrackcourier.com

# WhatsApp Notification Configuration
# Modes: MOCK | TWILIO | META | WEBHOOK
WHATSAPP_PROVIDER=MOCK
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SENDER_NUMBER=+919876543210

# Twilio (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Company Defaults
COMPANY_NAME=FastTrack Bus Parcel & Courier Services
COMPANY_PHONE=+91 98765 43210
COMPANY_EMAIL=dispatch@fasttrackcourier.com
COMPANY_ADDRESS=Main Bus Terminal Road, Complex #4, Hyderabad, TS - 500001
